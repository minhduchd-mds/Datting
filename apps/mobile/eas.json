{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "demo": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_BASE": "",
        "EXPO_PUBLIC_WS_URL": ""
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_BASE": "",
        "EXPO_PUBLIC_WS_URL": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.datting.app",
        "EXPO_PUBLIC_WS_URL": "wss://ws.datting.app/ws"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.datting.app",
        "EXPO_PUBLIC_WS_URL": "wss://ws.datting.app/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
